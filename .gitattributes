# Text tools and documentation use stable LF line endings.
*.v text eol=lf
*.sv text eol=lf
*.vh text eol=lf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf

# Never normalize verified hardware, IP, constraints, ROM or resource bytes.
/rtl/** -text
/assets/** -text
/td_project/*.al -text
/td_project/*.sdc -text
/sim/cnn/data/network_reference/*.hex -text -diff
