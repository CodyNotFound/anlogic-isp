// Generated by scripts/pack_yunet_rom.py; canonical bias.hex/shift.hex remain authoritative.
function signed [31:0] unpack_model_bias;
input [10:0] addr; input [15:0] low; reg [15:0] high;
begin case(addr)
11'd10: high=16'hfffe;
11'd13: high=16'h0000;
11'd920: high=16'hfffe;
default: high={16{low[15]}};
endcase unpack_model_bias={high,low}; end
endfunction
function signed [6:0] unpack_model_shift;
input [10:0] addr; input [2:0] code;
begin case(addr)
11'd856: unpack_model_shift=7'd17;
11'd920: unpack_model_shift=7'd23;
11'd954: unpack_model_shift=7'd4;
default: unpack_model_shift=7'd5+{4'b0,code};
endcase end
endfunction
